{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default Debug",
      "description": "Dependency-light debug build for the research runtime core.",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AAFR_BUILD_TESTS": "ON",
        "AAFR_BUILD_QT_BROWSER": "OFF"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Optimized build for benchmark and evaluation runs.",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AAFR_BUILD_TESTS": "ON",
        "AAFR_BUILD_QT_BROWSER": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "release",
      "configurePreset": "release"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
